              "tags": [
                  "db"
              ],
              "summary": "Update document",
              "requestBody": {
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "examples": [ 
                              { "options": {"one": true}, "filter": { "_id": "0dd8f833cedfd48582693331"}, "update": { "$set": { "name": "John Doe" } } },
                              { "filter": { "productCat": "premium"}, "update": { "$set": { "responsible": "John Doe" } } }
                            ]
                        }
                    }
                }
            },
              "responses": {
