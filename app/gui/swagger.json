                  "404": {
                      "description": "Not found"
                  },
                  "500": {
                      "description": "Server error"
                  }
              }
          },
          "get": {
              "tags": [
                  "db"
              ],
              "summary": "Find documents",
              "parameters": [
                  {
                      "name": "query",
                      "in": "query",
                      "description": "Filter",
                      "required": false,
                      "schema": {
                          "type": "object",
                          "examples": [
                              "{\"abc.z\": { \"$ge\": 0.5 }}}"
                          ]
                      }
                  },
                  {
                    "name": "options",
                    "in": "query",
                    "description": "Options",
                    "required": false,
                    "schema": {
                        "type": "object",
                        "examples": [
                            "{}"
                        ]
                    }
                },
                {
                  "name": "projection",
                  "in": "query",
                  "description": "Projection",
                  "required": false,
                  "schema": {
                      "type": "array"
                  }
                }
              ],
              "responses": {
                  "200": {
                      "description": "OK"
                  },
                  "400": {
                      "description": "Bad request"
                  },
                  "401": {
                      "description": "Not authorized"
                  },
                  "404": {
                      "description": "Not found"
                  },
                  "500": {
                      "description": "Server error"
                  }
              }
          },
